{
  "name": "ai-booking-platform",
  "version": "1.0.0",
  "description": "Multi-tenant AI scheduling platform for restaurants, clinics, and call centers.",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsc -p tsconfig.json && node dist/server/index.js",
    "dev:all": "concurrently -n web,api \"npm:dev\" \"npm:dev:server\"",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "build:widget": "tsc -p tsconfig.widget.json && vite build --config vite.widget.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.app.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:widget": "tsc -p tsconfig.widget.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "seed": "node --experimental-strip-types scripts/seedData.ts",
    "seed:reset": "npm run seed -- --reset",
    "test:elevenlabs": "node --experimental-strip-types scripts/test-elevenlabs.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.31.0",
    "node-cron": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  }
}
