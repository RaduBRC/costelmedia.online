{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Environment */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],

    /* Emit */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    /* Interop / Module */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src/agent/**/*.ts",
    "src/analytics/**/*.ts",
    "src/api/**/*.ts",
    "src/auth/**/*.ts",
    "src/calendar/**/*.ts",
    "src/channels/**/*.ts",
    "src/cron/**/*.ts",
    "src/db/**/*.ts",
    "src/notifications/**/*.ts",
    "src/server/**/*.ts",
    "src/telephony/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/db/offlineDb.ts", "src/notifications/tokenBridge.ts"]
}
