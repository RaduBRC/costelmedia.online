# --- API server ---
PORT=8787
# Set to "false" to disable the in-process reminder cron (e.g. local dev
# against a shared Supabase project, where you don't want real reminders sent).
CRON_ENABLED=true
# Override if the externally-configured Twilio webhook URL's protocol/host
# ever differs from what Express sees (see src/api/webhooks.ts).
# Production: https://api.costelmedia.online (this app's split deployment —
# Vercel for the static frontend, Render for this API at that CNAMEd
# subdomain, per vercel.json/render.yaml — see render.yaml, already set there).
PUBLIC_WEBHOOK_BASE_URL=
# Comma-separated allowlist for CORS in production (src/utils/prodChecklist.ts
# flags a wildcard/unset value as a critical failure once NODE_ENV=production).
# Production: https://costelmedia.online,https://www.costelmedia.online
ALLOWED_ORIGINS=

# --- Groq (LLM inference) ---
GROQ_API_KEY=

# --- Supabase (Postgres + Auth) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Frontend copy of the same project (src/lib/supabaseClient.ts) — the
# VITE_ prefix is what Vite requires to expose a var to browser code, and
# ANON_KEY (not SERVICE_ROLE_KEY) is the one safe to ship in a bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Google Service Account (Calendar API + FCM HTTP v1) ---
# Create a service account in Google Cloud Console, enable the Calendar API,
# and share each tenant's Google Calendar with the service account's client_email.
# This is the platform-wide fallback used by any tenant that hasn't
# connected their own Google account below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FCM_PROJECT_ID=

# --- Google OAuth (per-tenant Calendar connection, /admin/settings) ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console, in the SAME project as the service account above (or a
# different one — either works). Register GOOGLE_OAUTH_REDIRECT_URI below
# as an authorized redirect URI on that client. A tenant that connects
# here is used in preference to the shared service account — see
# src/calendar/googleCalendarEngine.ts.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Production: https://api.costelmedia.online/api/integrations/google/callback
# — NEVER the frontend's costelmedia.online, which only serves the static
# Vercel build and has no route to receive this redirect. Whatever value
# you put here also has to be registered as an authorized redirect URI on
# this OAuth client in Google Cloud Console, exactly — Google rejects the
# request otherwise. (Already set to this value in render.yaml.)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/integrations/google/callback
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Production: generate a FRESH one — do not reuse a local dev value.
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
# Where /callback redirects the browser back to after connecting — the
# frontend dashboard's own origin, not this API's.
# Production: https://costelmedia.online (already set in render.yaml)
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend build-time (Vite — read via import.meta.env, must be set
# wherever `npm run build` actually runs, e.g. Vercel's project env vars,
# not just this file) ---
# Base URL the deployed frontend calls for every /api/* request — see
# src/lib/api.ts. Leave unset for local dev (Vite proxies same-origin).
# Production: https://api.costelmedia.online — set this in Vercel's
# project env vars (build-time), not here; this file never runs in Vercel's
# build.
VITE_API_BASE_URL=

# --- Apple Push Notification service (Live Activities) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
APNS_USE_SANDBOX=false

# --- Web Push (PWA) ---
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:ops@example.com

# --- Twilio (SMS/WhatsApp) — platform-level shared account ---
# Individual tenants can override these via tenants.twilio_account_sid /
# twilio_auth_token / twilio_phone_number (see 004_twilio_channel.sql);
# these are the fallback used when a tenant hasn't brought their own.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# Minimum ms between two outbound sends to the same tenant (rate limiting).
TWILIO_MIN_SEND_INTERVAL_MS=1100

# --- Voice call agent (src/telephony/) ---
# Deepgram real-time streaming STT (free tier includes streaming).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# ElevenLabs streaming TTS, requested at output_format=ulaw_8000 so it's
# already Twilio-ready with no transcoding step. Also backs POST /api/tts
# (src/api/routes/tts.ts), which requests mp3_44100_128 instead for
# browser playback.
ELEVENLABS_API_KEY=
# A premade voice ID (e.g. 21m00Tcm4TlvDq8ikWAM / "Rachel") is the
# sensible default choice — but note that on a Free-tier ElevenLabs
# account, premade/library voices still require a paid plan for API
# access ("Free users cannot use library voices via the API"), same as
# any other library voice. A voice actually owned/cloned on the account
# is the only kind that works on Free.
ELEVENLABS_VOICE_ID=
# Leave unset (not just blank) to use the code's own default
# (eleven_multilingual_v2); set explicitly only to override it, e.g. to
# eleven_flash_v2_5 if low-latency streaming matters more than quality for
# you (also the automatic fallback if the primary model gets rejected —
# see elevenLabsTts.ts's FALLBACK_MODEL_ID).
ELEVENLABS_MODEL_ID=
